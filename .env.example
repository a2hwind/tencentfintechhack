# Copy to .env (or export) before starting the API. Every value has a working default.

# ---- LLM (OpenAI-compatible; leave LLM_API_KEY empty to run the deterministic stub) ----
# Tencent Cloud International, TokenHub (Hy models), recommended for a Singapore team:
#   LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1   (the host in Tencent Cloud's Hy API guide)
#   LLM_MODEL_PLANNER=hy3
#   LLM_MODEL_ANSWER=hy3            (or hy4-preview: larger reasoning model, slower)
# Hunyuan on the Tencent Cloud China console:
#   LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
#   LLM_MODEL_PLANNER=hunyuan-turbos-latest
#   LLM_MODEL_ANSWER=hunyuan-turbos-latest
#   EMBEDDINGS=hunyuan  EMBEDDING_MODEL=hunyuan-embedding   (1024 dimensions)
# Check any endpoint before the demo:  python scripts/smoke_llm.py
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_PLANNER=hy3
LLM_MODEL_ANSWER=hy3
LLM_TIMEOUT_S=30
# JSON merged into every chat request. Unset: {"enable_enhancement": false} for Hunyuan endpoints
# (no web search may leak into an answer grounded in company documents), {} otherwise.
LLM_EXTRA_BODY=

# Second-pass verifier over each answer sentence and its cited chunk:
#   lexical (default, deterministic: content terms and numbers must appear in the cited text)
#   llm     (a second small model call; falls back to lexical when no key is set)
#   off
VERIFIER=lexical
VERIFIER_MIN_OVERLAP=0.25

# ---- Embeddings ----
#   hash       no download, deterministic (default)
#   bge-small  sentence-transformers BAAI/bge-small-en-v1.5 (pip install -e ".[embeddings]")
#   hunyuan    Hunyuan embeddings through the OpenAI-compatible /embeddings endpoint (uses LLM_BASE_URL + LLM_API_KEY)
#   openai     any other OpenAI-compatible /embeddings endpoint
# Changing the embedder clears the index on the next start (vectors are only comparable within one model).
EMBEDDINGS=hash
EMBEDDING_MODEL=hunyuan-embedding
# Optional override of the similarity floor below which a vector hit is treated as noise
EMBEDDING_MIN_SIMILARITY=

# ---- Slack: the Company A mock (default) or a real workspace ----
# SLACK_MODE=real indexes the channels the bot is invited to, checks every served thread at Slack
# (Gate 2: membership, thread existence, version), and takes Events at POST /webhooks/slack.
# Set up with: python scripts/slack_setup.py check | map | seed   (see the script for scopes)
SLACK_MODE=mock
SLACK_BOT_TOKEN=
# Enables the Events API webhook (Basic Information -> Signing Secret). Unsigned or stale requests get 401.
SLACK_SIGNING_SECRET=
# Brain user -> Slack user id, e.g. jdoe=U07ABCDEF,mlim=U07GHIJKL (scripts/slack_setup.py map prints it).
# Users left out have no Slack access in the Brain.
SLACK_USER_MAP=
SLACK_HISTORY_DAYS=90
# A poll re-reads this many days of history for new replies; older threads rely on events (and Gate 2).
SLACK_LOOKBACK_DAYS=7
# Gate 2 reuses one channel's member list for this long (concurrent checks share one call).
SLACK_MEMBERSHIP_TTL_S=2

# ---- Storage ----
BRAIN_DATA_DIR=data
# BRAIN_DB defaults to $BRAIN_DATA_DIR/brain.db
BRAIN_FIXTURE=internal_brain/mocks/fixtures/company_a.yaml

# ---- Side channels ----
# Empty results (restricted or non-existent alike) take at least this long, so timing cannot tell them apart. 0 disables.
NO_RESULT_MIN_LATENCY_MS=25

# ---- Freshness ----
SYNC_INTERVAL_S=60
ENTITLEMENT_TTL_S=60
GATE2_TIMEOUT_S=2.0

# ---- Audit ----
CHECKPOINT_EVERY=5
# AUDIT_KEY_DIR defaults to $BRAIN_DATA_DIR; holds audit_signing.key (private, Ed25519) and audit_public.key
AUDIT_KEY_DIR=

# ---- UI ----
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
