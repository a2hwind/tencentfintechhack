# One Caddy in front of the UI (/) and the API (/api, prefix stripped). docker compose reads these from .env;
# on Render they are set by deploy/render/start.sh and the service's environment:
#   SITE_ADDRESS   :80 serves plain HTTP on the server's IP; a hostname (brain.example.com) turns on automatic HTTPS.
#   DEMO_PASSWORD  puts the site behind the browser's password prompt (user DEMO_USER, default "judge").
#                  deploy/caddy-start.sh hashes it at startup and sets DEMO_AUTH=on. Two paths stay open: Slack's
#                  webhook (Slack cannot answer a password prompt; the API rejects any request Slack did not sign)
#                  and the health check the hosting platform polls.
#   API_UPSTREAM, UI_UPSTREAM  where the API and the UI listen (compose: the api and ui services).

(auth-off) {
}

(auth-on) {
	@locked {
		not path /api/webhooks/slack /api/health
	}
	basic_auth @locked {
		{$DEMO_USER:judge} {$DEMO_PASSWORD_HASH}
	}
}

{$SITE_ADDRESS::80} {
	import auth-{$DEMO_AUTH:off}

	# Compress everything except the compliance console's live stream (server-sent events must not be buffered).
	@compressible {
		not path /api/audit/stream*
	}
	encode @compressible gzip

	# The mock Confluence, Jira, Slack and Drive stand in for systems that are not on the public internet.
	# The adapters reach them in-process, so their own HTTP APIs are not served from here.
	handle /api/mock/* {
		respond 404
	}

	# The UI calls the API at /api/...; the prefix is stripped before proxying (the API runs with
	# UVICORN_ROOT_PATH=/api, so its interactive docs at /api/docs send their requests to /api too).
	# Slack's Event Subscriptions request URL is https://<host>/api/webhooks/slack.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# /docs kept as a short link for judges who want to try the negative cases themselves.
	redir /docs /api/docs

	handle {
		reverse_proxy {$UI_UPSTREAM:ui:3000}
	}
}
